# Copy to .env on the Pi (optional). Compose reads these automatically.

# Until the USB camera arrives: synthetic test pattern, no /dev/video0 needed.
USE_TEST_PATTERN=1

# When the camera is connected (set USE_TEST_PATTERN=0):
# V4L2_DEVICE=/dev/video0
# V4L2_INPUT_FORMAT=mjpeg
# Many webcams also support yuyv422 at lower resolution:
# V4L2_INPUT_FORMAT=yuyv422
# VIDEO_WIDTH=640
# VIDEO_HEIGHT=480

# FFMPEG_LOGLEVEL=info
