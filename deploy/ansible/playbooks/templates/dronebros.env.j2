IMAGE_REGISTRY={{ stack_reg }}
IMAGE_TAG={{ stack_tag }}
{% if compose_profiles | default('') | trim | length > 0 %}
COMPOSE_PROFILES={{ compose_profiles | trim }}
{% endif %}
HMI_HOST_PORT={{ hmi_host_port | default(8080) }}
HMI_DATA_DIR={{ deploy_dir }}/hmi-data
DISPLAY_HOSTNAME={{ hmi_display_hostname_cmd.stdout | trim }}
{% if fc_serial_device | default('') | trim | length > 0 %}
FC_SERIAL_DEVICE={{ fc_serial_device | trim }}
{% endif %}
{% if fc_serial_baud | default('') | trim | length > 0 %}
FC_SERIAL_BAUD={{ fc_serial_baud | trim }}
{% endif %}
{% if fc_mavlink_sr_port | default('') | trim | length > 0 %}
FC_MAVLINK_SR_PORT={{ fc_mavlink_sr_port | trim }}
{% endif %}
